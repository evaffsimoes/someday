<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- "cue" header label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="cue ✦"
        android:textColor="#C084FC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginBottom="6dp" />

    <!-- Event card 0 (next / highlighted) -->
    <LinearLayout
        android:id="@+id/w_card_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/cal_cell_bg_event"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/badge_background"
            android:padding="5dp"
            android:layout_marginEnd="8dp">
            <TextView android:id="@+id/w_item_0_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/w_item_0_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#A1A1AA"
                android:textSize="9sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/w_item_0_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView android:id="@+id/w_item_0_loc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C084FC"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Event card 1 -->
    <LinearLayout
        android:id="@+id/w_card_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/cal_cell_bg_empty"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:layout_marginEnd="8dp">
            <TextView android:id="@+id/w_item_1_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#C084FC"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/w_item_1_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#71717A"
                android:textSize="9sp"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/w_item_1_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView android:id="@+id/w_item_1_loc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A1A1AA"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Event card 2 -->
