<?xml version="1.0" encoding="utf-8"?>
<!-- One event in the list widget: glass row with a date badge in the event's colour -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_row_glass"
    android:padding="9dp"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <!-- Date badge: a white shape tinted with the event colour at runtime -->
    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="10dp">
        <ImageView
            android:id="@+id/item_badge_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/badge_shape"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:id="@+id/item_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView android:id="@+id/item_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#D9FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>

    <!-- Name, when, where and tags -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/item_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView android:id="@+id/item_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
        <TextView android:id="@+id/item_loc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
        <TextView android:id="@+id/item_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FDBA74"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
