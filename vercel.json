{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://cue-events-21ac9.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/.netlify/functions/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/share-target",
      "destination": "/index.html"
    }
  ]
}